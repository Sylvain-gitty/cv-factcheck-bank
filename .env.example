# Copy to .env, or run: python scripts/init_env.py  (generates fresh secrets)
# .env is gitignored. Never commit real values.

TZ=Europe/Berlin

POSTGRES_USER=jobengine
POSTGRES_PASSWORD=change-me

# Encrypts credentials stored in n8n. Losing it makes saved n8n credentials unreadable;
# back it up with the database.
N8N_ENCRYPTION_KEY=change-me

# Bearer token n8n uses to call factbank-api.
API_TOKEN=change-me
